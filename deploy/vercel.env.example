# â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

# â”€â”€ Required â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# âœï¸ After your first deploy, set this to your real Vercel URL, then redeploy.
NEXT_PUBLIC_SITE_URL=https://YOUR-APP.vercel.app

# âœï¸ Signs anonymous session cookies. Paste the unique secret you were given
# (or generate one: `openssl rand -hex 32`). Do NOT reuse a public value.
FILEPIZZA_SECRET=PASTE_YOUR_64_CHAR_SECRET_HERE

# â”€â”€ WebRTC (âœ… free, already works â€” these just pin the free public TURN) â”€â”€â”€â”€â”€
# Free public TURN from Metered Open Relay (no account needed). Optional: the
# app already uses these by default, but setting them explicitly is fine.
TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
STUN_SERVER=stun:stun.l.google.com:19302
# PeerJS: public server works out of the box. Leave default unless self-hosting.
PEERJS_HOST=0.peerjs.com
PEERJS_PATH=/

# â”€â”€ Redis â€” scaling (âœï¸ Upstash, free, NO credit card) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# upstash.com â†’ Create Database (Redis) â†’ copy the "rediss://" URL here.
# Needed so stats/presence stay consistent across Vercel's instances.
# REDIS_URL=rediss://default:********@your-db.upstash.io:6379

# â”€â”€ Accounts + Google login (âœï¸ Supabase, free, NO credit card) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# supabase.com â†’ New project â†’ Settings â†’ API.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key   # enables account delete
# SUPABASE_AVATAR_BUCKET=avatars
ADMIN_EMAILS=contact@zestcommere.in

# â”€â”€ Contact email (âœï¸ Hostinger SMTP â€” your mailbox) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=contact@zestcommere.in
# SMTP_PASS=your-mailbox-password
SMTP_FROM=contact@zestcommere.in

# â”€â”€ Profile-photo upload (âœ… your Hostinger PHP endpoint) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Deploy deploy/hostinger/api4/ to https://api.zestcommerce.in/api4/ first.
# The token below already matches ZYNC_UPLOAD_SECRET in api4/config.php.
HOSTINGER_UPLOAD_URL=https://api.zestcommerce.in/api4/upload.php
HOSTINGER_API_TOKEN=PASTE_YOUR_64_CHAR_UPLOAD_TOKEN_HERE

# â”€â”€ Analytics & anti-spam (âœï¸ optional) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
# RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key
