[Unit]
Description=Zync web app (Next.js)
After=network.target redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/zync
EnvironmentFile=/home/ubuntu/zync/.env.local
# Build once with `pnpm build`, then `pnpm start` serves on PORT (default 3000)
Environment=PORT=3000
ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
