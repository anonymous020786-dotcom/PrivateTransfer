# Copy to deploy/vps/.env on the VPS and fill in. Do NOT commit the real .env.

# --- Required ---
SITE_DOMAIN=videodownloaders.cloud
NEXT_PUBLIC_SITE_URL=https://videodownloaders.cloud
# 64-hex session secret. Generate with: openssl rand -hex 32
FILEPIZZA_SECRET=CHANGE_ME_64_HEX

# Self-hosted PeerJS on the same domain (served at /peerjs by Caddy)
PEERJS_HOST=videodownloaders.cloud
PEERJS_PATH=/peerjs/filepizza

# Admin dashboard allowlist
ADMIN_EMAILS=zestcommerce841428@gmail.com

# --- Optional: accounts + Google login (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=avatars

# --- Optional: contact email (Hostinger SMTP) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@videodownloaders.cloud
SMTP_PASS=
SMTP_FROM=contact@videodownloaders.cloud

# --- Cloudflare R2 (server-side file storage for /transfer) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zync-transfers

# Cron cleanup secret — shared between the cron container and the app.
# Generate with: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_32_HEX

# --- Optional: analytics / anti-spam ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Free public TURN/STUN is ON by default. Leave this unless you self-host coturn.
# DISABLE_FREE_TURN=true
