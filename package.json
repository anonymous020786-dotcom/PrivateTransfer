{
  "name": "filepizza",
  "version": "2.0.0",
  "description": "Free peer-to-peer file transfers in your browser.",
  "author": "Alex Kern <alex@kern.io> (http://kern.io)",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/kern/filepizza",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next",
    "dev:full": "docker compose up redis coturn -d && COTURN_ENABLED=true REDIS_URL=redis://localhost:6379 next",
    "build": "next build && cp -r public .next/standalone/ && cp -r .next/static .next/standalone/.next/",
    "start": "next start",
    "start:peerjs": "./bin/peerjs.js",
    "lint:check": "eslint 'src/**/*.ts[x]'",
    "lint:fix": "eslint 'src/**/*.ts[x]' --fix",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:clean": "docker compose down -v --rmi all",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "pnpm lint:check && pnpm format:check && pnpm type:check && pnpm test && pnpm build && pnpm test:e2e && pnpm docker:build"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:kern/filepizza.git"
  },
  "bugs": {
    "url": "https://github.com/kern/filepizza/issues"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "autoprefixer": "^10.6.1",
    "debug": "^4.3.6",
    "express": "^5.0.0",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "next": "~16.3.6",
    "next-view-transitions": "^0.3.4",
    "nodemailer": "^10.0.11",
    "nodemon": "^3.1.14",
    "peer": "^1.0.0",
    "peerjs": "^1.5.4",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "~19.3.0",
    "react-device-detect": "^2.0.0",
    "react-dom": "~19.3.0",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.2.0",
    "reading-time": "^1.5.0",
    "remark-gfm": "^4.0.1",
    "streamsaver": "^2.0.6",
    "web-streams-polyfill": "^4.3.0",
    "webrtcsupport": "^2.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "~16.3.6",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.3",
    "husky": "^9.0.0",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
